[Unit]
Description=3TSAHUR mecanum hub and LARP scout dashboard
After=network.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=-/etc/stem-research-academy/config.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/bin/bash @APP_DIR@/installer/start-dashboard.sh @APP_DIR@
Restart=always
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
